#!/bin/bash
# انقر مرّتين على هذا الملف لتشغيل النظام.
cd "$(dirname "$0")" || exit 1

PORT=8787
URL="http://localhost:$PORT/index.html"

echo "──────────────────────────────────────────"
echo "  نظام التشغيل الشخصي للأعمال"
echo "  العنوان: $URL"
echo "  لإيقاف الخادم: أغلق هذه النافذة أو اضغط Ctrl+C"
echo "──────────────────────────────────────────"

# فتح المتصفح بعد لحظة
( sleep 1; open "$URL" ) &

# خادم ملفات محلي فقط — لا يرسل شيئًا إلى أي مكان
python3 -m http.server "$PORT" --bind 127.0.0.1
